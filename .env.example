# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL (public, safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Anon / public key  (public, safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role secret key  ← SERVER ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Groq ─────────────────────────────────────────────────────────────────────
# Server-only. Used for vision extraction, text summarization, and answering.
GROQ_API_KEY=gsk_your-groq-api-key
# Vision-capable model (supports image inputs)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Text model for summarisation, tagging, and answering
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# ─── OpenAI (embeddings only) ─────────────────────────────────────────────────
# Used exclusively for text-embedding-3-small to produce Pinecone vectors.
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Pinecone ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
# Name of your Pinecone index (must use dimension=1536 for text-embedding-3-small)
PINECONE_INDEX_NAME=my-memory-index

# ─── Upstash Redis (rate limiting + optional job queue) ───────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Internal ─────────────────────────────────────────────────────────────────
# Secret shared between the memory create route and the /api/process route.
PROCESS_SECRET=change-me-to-a-random-string
# Public base URL of the deployment (used to call internal API routes server-side)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
